% Resume template — formatting, colors, and macros.
% Edit content.tex for your data; do not change this file unless customizing layout.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{template}[2026/09/15 Resume template]

\usepackage[
  top=1.2cm,
  bottom=1.2cm,
  left=1.6cm,
  right=1.6cm
]{geometry}

\usepackage{fontspec}
\defaultfontfeatures{Ligatures=TeX}

\newcommand{\ResumeFontPath}{fonts/}
\newcommand{\ResumeFontOpts}{%
  Path=\ResumeFontPath,%
  Extension=.ttf,%
  UprightFont=*-Regular,%
  BoldFont=*-Bold,%
  ItalicFont=*-Italic,%
  BoldItalicFont=*-BoldItalic%
}
\setmainfont{Satoshi}[\ResumeFontOpts]
\setsansfont{Satoshi}[\ResumeFontOpts]
\renewcommand{\familydefault}{\sfdefault}
\usepackage{microtype}
\usepackage{setspace}
\usepackage{array}
\usepackage{calc}
\usepackage{enumitem}
\usepackage{graphicx}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{fontawesome5}
\usepackage{tikz}
\usepackage{titlesec}

% --- Colors ---
\definecolor{Accent}{HTML}{1F4E79}
\definecolor{SectionLine}{HTML}{6B9BB8}
\definecolor{PhotoBorder}{HTML}{8FB4D4}

\hypersetup{
  colorlinks=true,
  linkcolor=Accent,
  urlcolor=Accent,
  pdfborder={0 0 0}
}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setstretch{1.05}
\pagestyle{empty}

% Keep words whole — no hyphenated line breaks
\hyphenpenalty=10000
\exhyphenpenalty=10000
\brokenpenalty=10000
\tolerance=2000
\emergencystretch=2em

% --- Section headings with blue underline ---
\titleformat{\section}
  {\Large\bfseries\sffamily\color{black}}
  {}
  {0pt}
  {}
  [\vspace{2pt}{\color{SectionLine}\titlerule[0.6pt]}\vspace{6pt}]

\titlespacing*{\section}{0pt}{0pt}{4pt}

% --- Blue bookmark / ribbon bullet ---
\newcommand{\ribbon}{%
  \textcolor{Accent}{\small\faIcon{bookmark}}%
}

% --- Profile photo (override in content.tex) ---
\newcommand{\profilephoto}{profile.jpg}

\newcommand{\contactchip}[2]{%
  \mbox{%
    $\vcenter{\hbox{\textcolor{Accent}{\faIcon{#1}}}}$%
    \hspace{0.55em}%
    $\vcenter{\hbox{#2}}$%
  }%
}

\newcommand{\profileplaceholder}{%
  \begin{tikzpicture}
    \draw[PhotoBorder, line width=0.8pt, fill=PhotoBorder!15]
      (0,0) rectangle (3.1cm,3.1cm);
    \fill[Accent!35] (1.55cm,2.05cm) circle (0.48cm);
    \fill[Accent!35] (1.55cm,0.72cm) ellipse (0.78cm and 0.58cm);
  \end{tikzpicture}%
}

\newcommand{\renderprofilephoto}{%
  \IfFileExists{\profilephoto}{%
    \setlength{\fboxrule}{0.8pt}
    \setlength{\fboxsep}{2pt}
    \fcolorbox{PhotoBorder}{PhotoBorder!15}{%
      \includegraphics[width=3.0cm,height=3.0cm,keepaspectratio]{\profilephoto}%
    }%
  }{%
    \profileplaceholder
  }%
}

% #1 name, #2 email, #3 phone, #4 location, #5 link text, #6 link url, #7 linkedin url
\newcommand{\ResumeHeader}[7]{%
  \noindent
  \begin{tabular}[t]{@{}p{\dimexpr\textwidth-3.35cm\relax}@{}>{\raggedleft\arraybackslash}p{3.15cm}@{}}
    \vspace{0pt}%
    {\Huge\bfseries\sffamily #1\par}
    \vspace{8pt}

    \noindent
    \contactchip{envelope}{\href{mailto:#2}{\small #2}}%
    \hspace{1.5em}%
    \contactchip{phone}{\small #3}%
    \hspace{1.5em}%
    \contactchip{linkedin}{\href{#7}{\small LinkedIn}}%
    \par\vspace{4pt}

    \noindent
    \contactchip{map-marker-alt}{\small #4}%
    \hspace{1.5em}%
    \contactchip{github}{\href{#6}{\small #5}}%
    &
    \vspace{0pt}\renderprofilephoto
  \end{tabular}\par
  \vspace{-5pt}
}

% --- Timeline layout (minipage, not tabularx) ---
\newlength{\datecolwidth}
\setlength{\datecolwidth}{1.95cm}

\newcommand{\timelineentry}[2]{%
  \noindent
  \begin{minipage}[t]{\datecolwidth}
    \raggedleft\small #1
  \end{minipage}%
  \hspace{0.25cm}%
  \raisebox{-0.05ex}{\ribbon}%
  \hspace{0.3cm}%
  \begin{minipage}[t]{\dimexpr\textwidth-\datecolwidth-0.75cm\relax}
    #2
  \end{minipage}\par
  \vspace{10pt}
}

\newcommand{\roleheader}[3]{%
  \textbf{#1}\\[-0.5ex]
  \textit{#2}\hfill\textit{#3}\\[-6pt]
}

\newcommand{\workroleheader}[3]{%
  {\large
    \textbf{#1}\\[-0.5ex]
    \textit{#2}\hfill\textit{#3}\\[-6pt]
  }%
}

\newenvironment{resumeitems}{%
  \begin{itemize}[
    leftmargin=1.0em,
    itemsep=2pt,
    topsep=0pt,
    partopsep=0pt,
    parsep=0pt,
    label=\textcolor{black}{\textbullet}
  ]%
}{%
  \end{itemize}%
}

% Work experience: dates | company | title | location
\NewDocumentEnvironment{WorkEntry}{mmmm +b}{%
  \timelineentry{#1}{%
    \workroleheader{#2}{#3}{#4}%
    \begin{resumeitems}%
    #5%
    \end{resumeitems}%
  }%
}{}

% Education: date | school | degree | location
\NewDocumentEnvironment{EducationEntry}{mmmm +b}{%
  \timelineentry{#1}{%
    \roleheader{#2}{#3}{#4}%
    \ifstrempty{#5}{}{%
      \begin{resumeitems}%
      #5%
      \end{resumeitems}%
    }%
  }%
}{}

% Certifications, Skills & Interests section
\newenvironment{SkillsList}{%
  \begin{itemize}[
    leftmargin=1.2em,
    itemsep=4pt,
    topsep=2pt,
    parsep=0pt,
    label=\textcolor{Accent}{\faIcon{bookmark}}
  ]%
}{%
  \end{itemize}%
}

\newcommand{\SkillLine}[2]{%
  \item \textbf{#1:} #2%
}
